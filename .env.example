# 复制本文件为 .env 后按自己的 MySQL 配置修改
APP_NAME=社团生态平台
DEBUG=true

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=club_platform

# JWT 密钥（上线务必改成随机长字符串）
SECRET_KEY=please-change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 允许跨域的前端地址（本地开发 + 内网穿透的公网地址都写进来）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
